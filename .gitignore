# ==========================================
#  Bipinho — .gitignore (Python/FastAPI)
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
.pytest_cache/
*.spec

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/

# --- Banco de dados SQLite (criado em tempo de execução) ---
data/bipinho.db
data/*.db
data/*.db-wal
data/*.db-shm

# --- Mídia enviada pelo usuário e miniaturas geradas ---
media/uploads/
media/thumbs/

# --- Samples (arquivos de exemplo gerados pelo seed) ---
samples/

# --- Sistema operacional ---
.DS_Store
Thumbs.db
desktop.ini
*.lnk
*.log

# --- IDEs e editores ---
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo
*~

# --- Outros ---
*.bak
*.tmp
